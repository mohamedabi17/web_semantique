        {
          "text": "John Smith",
          "type": "PER"
        },
        {
          "text": "University of Cambridge",
          "type": "ORG"
        }
      ],
      "expected_relations": [
        {
          "subject": "John Smith",
          "predicate": "worksAt",
          "object": "University of Cambridge"
        }
      ]
    },
    {
      "id": "ORG_003",
      "category": "org_detection",
