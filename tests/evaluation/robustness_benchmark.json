{
  "benchmark_meta": {
    "name": "Robustness Benchmark — Neuro-Symbolic KG Extraction",
    "version": "1.0",
    "date": "2026-03-04",
    "description": "Stress-test suite for NER and relation extraction generalisation. 56 sentences across 7 categories.",
    "categories": [
      "org_detection",
      "topic_generalization",
      "short_acronym",
      "multi_entity",
      "ambiguous_context",
      "noise_robustness",
      "long_academic"
    ],
    "entity_type_map": {
      "Person": "PER",
      "Organization": "ORG",
      "Topic": "TOPIC",
      "Location": "LOC",
      "Document": "DOCUMENT"
    }
  },
  "tests": [
    // ======================================================================
    // CATEGORY 1 — Organization Detection (8 sentences)
    // Goal: vary org-name structure: "Université de X", "X University",
    //       "Centre/Institut/Lab de X", all-caps acronym orgs.
    // ======================================================================
    {
      "id": "ORG_001",
      "category": "org_detection",
      "description": "Simple French university with ADP connector",
      "text": "Marie Dupont travaille à l'Université de Lyon.",
      "expected_entities": [
        {
          "text": "Marie Dupont",
          "type": "PER"
        },
        {
          "text": "Université de Lyon",
          "type": "ORG"
        }
      ],
      "expected_relations": [
        {
          "subject": "Marie Dupont",
          "predicate": "worksAt",
          "object": "Université de Lyon"
        }
      ]
    },
    {
      "id": "ORG_002",
      "category": "org_detection",
      "description": "English university with 'of' connector",
      "text": "John Smith teaches at the University of Cambridge.",
